{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "BUILD_DIR": "build/${presetName}",
                "USE_SLANG": "OFF",
                "CMAKE_TLS_VERIFY": "OFF"
            }
        },
        {
            "name": "debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "vs2022",
            "hidden": true,
            "generator": "Visual Studio 17 2022"
        },
        {
            "name": "vs2026",
            "hidden": true,
            "generator": "Visual Studio 18 2026"
        },
        {
            "name": "ninja",
            "hidden": true,
            "generator": "Ninja"
        },
        {
            "name": "windows",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "EXAMPLE_CFG": "OFF"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-debug-vs2022",
            "inherits": ["windows", "debug", "vs2022"],
            "displayName": "windows debug vs2022"
        },
        {
            "name": "windows-release-vs2022",
            "inherits": ["windows", "release", "vs2022"],
            "displayName": "windows release vs2022"
        },
        {
            "name": "windows-debug-vs2026",
            "inherits": ["windows", "debug", "vs2026"],
            "displayName": "windows debug vs2026"
        },
        {
            "name": "windows-release-vs2026",
            "inherits": ["windows", "release", "vs2026"],
            "displayName": "windows release vs2026"
        }
    ],
    "buildPresets": [
        {
            "name": "build-windows-debug-vs2022",
            "configurePreset": "windows-debug-vs2022",
            "configuration": "Debug"
        },
        {
            "name": "build-windows-release-vs2022",
            "configurePreset": "windows-release-vs2022",
            "configuration": "Release",
            "targets": [
                "ALL_BUILD",
                "install"
            ]
        },
        {
            "name": "build-windows-debug-vs2026",
            "configurePreset": "windows-debug-vs2026",
            "configuration": "Debug"
        },
        {
            "name": "build-windows-release-vs2026",
            "configurePreset": "windows-release-vs2026",
            "configuration": "Release",
            "targets": [
                "ALL_BUILD",
                "install"
            ]
        }
    ]
}
